; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Knot My Problem"
config/description="Vertical Slice: Kabel ziehen, Knoten lösen, aufrollen."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Balancing="*res://scripts/core/balancing.gd"
Settings="*res://scripts/core/settings.gd"
Net="*res://scripts/net/net.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194325)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":69)]
}
pull={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":1)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32)]
}
release={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":81)]
}
tablet={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194306)]
}
decline={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":78)]
}
quicksave={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194336)]
}
quickload={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194340)]
}

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg")
